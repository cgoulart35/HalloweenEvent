# WEBAPP PROPERTIES
VERSION=1.0
TZ=America/New_York
LOG_LEVEL=INFO
WEBAPP_PORT=5004
# Required for stable sessions; generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# If blank, a random per-boot key is used (sessions lost on restart).
SECRET_KEY=

# COMMUNICATION PROPERTIES
API_HOST=http://192.168.50.83:5007

# AUTH PROPERTIES (secret -- must match api.env; required)
API_KEY=

# CREDENTIAL PROPERTIES (secret -- filled in from the Shared dir at deploy time)
FIREBASE_CONFIG_JSON=

# CAPTCHA PROPERTIES (Cloudflare Turnstile; leave blank to disable CAPTCHA for local/QA dev)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# QA ONLY -- leave blank/unset in production.
# EVENT_ROOT must match the API's value so both apps use the same sandbox node.
# EVENT_ROOT=
